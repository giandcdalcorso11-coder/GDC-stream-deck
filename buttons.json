{
  "settings": { "port": 8080, "token": "", "theme": "windows" },

  "volumeApps": [
    { "id": "spotify", "label": "Spotify", "exe": "spotify.exe" },
    { "id": "edge",    "label": "Edge",    "exe": "msedge.exe" },
    { "id": "discord", "label": "Discord", "exe": "discord.exe" }
  ],

  "desktop": [
    { "id": "dk-prev",  "label": "Desktop<br>precedente",   "icon": "left",     "cat": "sys",    "action": { "type": "hotkey", "keys": "win+ctrl+left" } },
    { "id": "dk-next",  "label": "Desktop<br>successivo",   "icon": "right",    "cat": "sys",    "action": { "type": "hotkey", "keys": "win+ctrl+right" } },
    { "id": "dk-view",  "label": "Panoramica<br>di tutte le app", "icon": "overview", "cat": "work", "span": 2, "action": { "type": "hotkey", "keys": "win+tab" } },
    { "id": "dk-new",   "label": "Nuovo<br>desktop",        "icon": "plus",     "cat": "audio",  "action": { "type": "hotkey", "keys": "win+ctrl+d" } },
    { "id": "dk-close", "label": "Chiudi<br>desktop",       "icon": "xx",       "cat": "danger", "action": { "type": "hotkey", "keys": "win+ctrl+f4" } }
  ],

  "pages": [
    {
      "id": "default", "name": "Predefinito", "match": [],
      "buttons": [
        { "id": "youtube", "label": "YouTube",          "icon": "video", "cat": "audio", "span": 2, "action": { "type": "url", "url": "https://www.youtube.com" } },
        { "id": "taskmgr", "label": "Gestione attività", "icon": "task",  "cat": "sys",   "span": 2, "action": { "type": "hotkey", "keys": "ctrl+shift+esc" } },
        { "id": "saver",   "label": "Screen saver",     "icon": "saver", "cat": "work",  "span": 2, "action": { "type": "saver" } },
        { "id": "showdesk","label": "Mostra desktop",   "icon": "desk",  "cat": "sys",   "small": true, "action": { "type": "hotkey", "keys": "win+d" } },
        { "id": "shot",    "label": "Screenshot",       "icon": "shot",  "cat": "work",  "small": true, "action": { "type": "hotkey", "keys": "win+shift+s" } }
      ]
    },
    {
      "id": "claude", "name": "Claude", "match": ["msedge.exe"], "matchTitle": ["Claude"],
      "buttons": [
        { "id": "cl-new",    "label": "Nuova chat",     "icon": "chat",   "cat": "work",   "action": { "type": "url", "url": "https://claude.ai/new" } },
        { "id": "cl-code",   "label": "Claude Code",    "icon": "term",   "cat": "work",   "action": { "type": "run", "path": "wt.exe", "args": ["claude"] } },
        { "id": "cl-search", "label": "Cerca",          "icon": "search", "cat": "sys",    "action": { "type": "hotkey", "keys": "ctrl+k" } },
        { "id": "cl-proj",   "label": "Progetti",       "icon": "folder", "cat": "sys",    "action": { "type": "url", "url": "https://claude.ai/projects" } },
        { "id": "cl-web",    "label": "Apri claude.ai", "icon": "globe",  "cat": "sys",    "action": { "type": "url", "url": "https://claude.ai" } },
        { "id": "cl-dict",   "label": "Dettatura",      "icon": "mic",    "cat": "audio",  "action": { "type": "hotkey", "keys": "win+h" } },
        { "id": "cl-shot",   "label": "Screenshot",     "icon": "shot",   "cat": "sys",    "action": { "type": "hotkey", "keys": "win+shift+s" } },
        { "id": "cl-stop",   "label": "Interrompi",     "icon": "xx",     "cat": "danger", "action": { "type": "hotkey", "keys": "esc" } }
      ]
    },
    {
      "id": "resolve", "name": "DaVinci", "match": ["resolve.exe"],
      "buttons": [
        { "id": "dv-play",  "label": "Play / Pausa", "icon": "play",    "cat": "audio",  "action": { "type": "hotkey", "keys": "space" } },
        { "id": "dv-cut",   "label": "Taglia",       "icon": "blade",   "cat": "work",   "action": { "type": "hotkey", "keys": "ctrl+backslash" } },
        { "id": "dv-undo",  "label": "Annulla",      "icon": "undo",    "cat": "sys",    "action": { "type": "hotkey", "keys": "ctrl+z" } },
        { "id": "dv-save",  "label": "Salva",        "icon": "save",    "cat": "sys",    "action": { "type": "hotkey", "keys": "ctrl+s" } },
        { "id": "dv-in",    "label": "Segna IN",     "icon": "markin",  "cat": "sys",    "action": { "type": "hotkey", "keys": "i" } },
        { "id": "dv-out",   "label": "Segna OUT",    "icon": "markout", "cat": "sys",    "action": { "type": "hotkey", "keys": "o" } },
        { "id": "dv-mark",  "label": "Marker",       "icon": "flag",    "cat": "work",   "action": { "type": "hotkey", "keys": "m" } },
        { "id": "dv-del",   "label": "Elimina",      "icon": "trash",   "cat": "danger", "action": { "type": "hotkey", "keys": "delete" } }
      ]
    },
    {
      "id": "bambu", "name": "Bambu Studio", "match": ["bambu-studio.exe"],
      "buttons": [
        { "id": "bs-slice",  "label": "Slice",    "icon": "layers",  "cat": "work",   "action": { "type": "hotkey", "keys": "ctrl+r" } },
        { "id": "bs-print",  "label": "Stampa",   "icon": "printer", "cat": "danger", "action": { "type": "hotkey", "keys": "ctrl+p" } },
        { "id": "bs-arr",    "label": "Disponi",  "icon": "arrange", "cat": "sys",    "action": { "type": "hotkey", "keys": "a" } },
        { "id": "bs-orient", "label": "Orienta",  "icon": "rotate",  "cat": "sys",    "action": { "type": "hotkey", "keys": "o" } },
        { "id": "bs-move",   "label": "Sposta",   "icon": "move",    "cat": "sys",    "action": { "type": "hotkey", "keys": "m" } },
        { "id": "bs-scale",  "label": "Scala",    "icon": "scale",   "cat": "sys",    "action": { "type": "hotkey", "keys": "s" } },
        { "id": "bs-iso",    "label": "Vista iso","icon": "cube",    "cat": "sys",    "action": { "type": "hotkey", "keys": "0" } },
        { "id": "bs-save",   "label": "Salva",    "icon": "save",    "cat": "sys",    "action": { "type": "hotkey", "keys": "ctrl+s" } }
      ]
    }
  ]
}
